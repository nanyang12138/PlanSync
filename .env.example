# =============================================================================
# PlanSync Environment Configuration
# =============================================================================
# Copy to .env and edit as needed: cp .env.example .env
#
# `./bin/ps-admin start` auto-copies this file to .env on first run.
#
# What you actually need to edit:
#   1. AI features won't work without an API key — set LLM_API_KEY (AMD)
#      or ANTHROPIC_API_KEY. Without one of these, semantic plan diff,
#      AI completion verification, and conflict prediction all silently
#      no-op. Half the value of PlanSync. Don't skip this.
#   2. Shared host / cluster: you MUST change PG_PORT to avoid colliding
#      with other users' Postgres on the same machine.
#
# Local single-user laptop without AI: defaults work, edit nothing.
# =============================================================================


# ─── DATABASE — PG_PORT MUST be unique on shared hosts ───────────────────────
# Multiple users on the same machine WILL collide on the default port and
# connect to each other's PostgreSQL. Pick a per-user port:
#   PG_PORT=$(expr 15000 + $(id -u) % 1000)
PG_PORT=15432
DATABASE_URL=postgresql://${USER}@localhost:${PG_PORT}/plansync_dev


# ─── AI FEATURES — strongly recommended (set one) ────────────────────────────
# Without an API key, these silently stop working:
#   - semantic plan diff (plan_diff returns rule-based diff only)
#   - AI completion verification (deliverablesMet check in execution_complete)
#   - AI task-conflict prediction (plansync_check_task_conflicts returns null)
#   - AI-enriched drift impact analysis
# Pick exactly one provider.
#
# Option A — AMD internal LLM (Anthropic-compatible)
# LLM_API_KEY=
# LLM_API_BASE=https://llm-api.amd.com/Anthropic
# LLM_MODEL_NAME=Claude-Sonnet-4.5
#
# Option B — Anthropic official API
# ANTHROPIC_API_KEY=sk-ant-xxx


# ─── EMAIL NOTIFICATIONS ─────────────────────────────────────────────────────
# Uses /usr/sbin/sendmail directly — no SMTP setup needed on Linux.
# EMAIL_DOMAIN is appended to your $USER (e.g. nanyang2 → nanyang2@amd.com).
EMAIL_DOMAIN=amd.com
# EMAIL_FROM=plansync@amd.com
# EMAIL_SENDMAIL=/usr/sbin/sendmail   # override sendmail binary path (optional)


# ─── IDENTITY (rarely needed — only override if defaults don't suit you) ─────
# bin/plansync handles all of these for you on first run:
#   - prompts for username (default: $USER) and password (= your API key)
#   - saves them to ~/.config/plansync/env
# Set them here only if you need a different value or are running on a host
# that bin/plansync isn't managing.
# PLANSYNC_USER=
# PLANSYNC_API_URL=http://localhost:3001
# PLANSYNC_API_KEY=


# ─── CODING AGENT BINARY (R-102) ─────────────────────────────────────────────
# `/exec` and `!shell`-style commands spawn an external coding agent (Claude
# Code, Genie, etc.). The CLI resolves the binary in this order:
#   1. PLANSYNC_CODE_BIN — preferred, agent-agnostic override
#   2. GENIE_BIN         — legacy AMD-internal name, still honoured
#   3. `claude`          — generic fallback, resolved via $PATH
# Set this when the binary lives outside $PATH or you want to use a specific
# build. The CLI does not validate the value at startup; the spawn will fail
# with ENOENT if the binary cannot be located.
# PLANSYNC_CODE_BIN=/usr/local/bin/claude

# ─── API SERVER (advanced — defaults are fine) ───────────────────────────────
# PORT=3001                   # API server port
# AUTH_DISABLED=false         # true = skip auth (local dev only, never in prod)
# LOG_LEVEL=info              # debug | info | warn | error
# NODE_ENV=development

# ─── REGISTRATION POLICY ─────────────────────────────────────────────────────
# Controls what happens when POST /api/auth/login receives a username that
# does not yet have an account.
#   false (default) — the server returns 401. Owners must pre-create accounts:
#                        bin/ps-admin create-user <name>
#   true            — the first password POSTed for an unknown username
#                     creates the account and claims it (legacy behaviour;
#                     suitable only for isolated dev hosts).
# PLANSYNC_OPEN_REGISTRATION=false

# ─── SECURITY — MUST set in production ───────────────────────────────────────
# PLANSYNC_SECRET is the master delegation token: with it, the server owner
# can act as any registered user (used for multi-user simulation in dev and
# for trusted server-to-server scripts in prod).
#
# Rules (enforced at boot when NODE_ENV=production):
#   - MUST be set (no default)
#   - MUST NOT equal "dev-secret"
#   - MUST be at least 32 characters
#
# Generate one with:
#   openssl rand -hex 32
#
# In development the variable is optional; leaving it unset disables master
# delegation entirely (recommended for shared dev hosts).
# PLANSYNC_SECRET=

# ─── EVENT BUS BACKEND (R-088) ───────────────────────────────────────────────
# Selects how SSE events are fanned out to subscribers.
#   memory   — in-process only. Cross-instance events ARE NOT delivered;
#              fine for a single-process dev server or a single API replica.
#   postgres — uses Postgres LISTEN/NOTIFY. Required for any deployment with
#              more than one API process so SSE clients connected to instance
#              A see events published by instance B.
# Default: postgres in production, memory elsewhere.
# PLANSYNC_EVENT_BUS=postgres


# ─── WEBHOOK SSRF ALLOWLIST (optional, production only) ──────────────────────
# Comma-separated list of hostnames that bypass the production SSRF protection
# on POST /api/projects/:id/webhooks. By default in production:
#   - webhook URLs must be https
#   - hosts in private / loopback / link-local / cloud-metadata ranges are
#     rejected (10/8, 127/8, 169.254/16, 172.16/12, 192.168/16, ::1, fc00::/7,
#     fe80::/10, "localhost", "*.local", "*.localhost")
# Add hostnames here to opt-in (e.g. an internal webhook receiver):
#   PLANSYNC_WEBHOOK_ALLOWLIST=internal-hooks.example.com,monitor.svc.cluster.local
# PLANSYNC_WEBHOOK_ALLOWLIST=
