generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  phase               String   @default("planning") // planning | active | completed
  repoUrl             String?  @map("repo_url")
  defaultBranch       String?  @map("default_branch")
  // R-190: GitHub webhook integration. `githubRepo` is the `owner/repo` slug
  // used to scope incoming `push` / `pull_request` / `pull_request_review`
  // events to this project, and `githubWebhookSecret` is the HMAC SHA-256
  // shared secret configured in the GitHub webhook UI (sent as the
  // `X-Hub-Signature-256` header). Both are nullable so projects without
  // GitHub integration keep working unchanged.
  githubRepo          String?  @map("github_repo")
  githubWebhookSecret String?  @map("github_webhook_secret")
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  members           ProjectMember[]
  plans             Plan[]
  tasks             Task[]
  driftAlerts       DriftAlert[]
  activities        Activity[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  planDiffs         PlanDiff[]
  verificationRules VerificationRule[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  role      String   @default("developer") // owner | developer
  type      String   @default("human") // human | agent
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_members")
}

model Plan {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  version           Int
  status            String    @default("draft") // draft | proposed | active | superseded
  title             String
  goal              String
  scope             String
  constraints       String[]
  standards         String[]
  deliverables      String[]
  openQuestions     String[]  @map("open_questions")
  changeSummary     String?   @map("change_summary")
  why               String?
  requiredReviewers String[]  @map("required_reviewers")
  createdBy         String    @map("created_by")
  activatedAt       DateTime? @map("activated_at")
  activatedBy       String?   @map("activated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews          PlanReview[]
  suggestions      PlanSuggestion[]
  comments         PlanComment[]
  // R-150: structured back-references to the new per-item tables that
  // supplement (without replacing) the legacy String[] columns above. The
  // arrays remain the canonical read path for current code; the structured
  // rows live alongside them as an additive, slug-addressable representation
  // for drift-engine v3, completion verification rules, and per-item
  // comments. See migration `20260523000000_add_plan_items_split` and the
  // R-150 entry in docs/REMEDIATION_PLAN.md for the rollout plan.
  planDeliverables PlanDeliverable[]
  planConstraints  PlanConstraint[]
  planStandards    PlanStandard[]
  // R-082: back-references for PlanDiff FK constraints; if a plan is deleted
  // (only drafts can be deleted today), any cached diffs referencing it are
  // cascaded away because they are meaningless without the underlying plan.
  diffsFrom        PlanDiff[]        @relation("PlanDiffFromPlan")
  diffsTo          PlanDiff[]        @relation("PlanDiffToPlan")
  // R-083: back-reference for the composite FK from Task.(projectId, boundPlanVersion)
  // to Plan.(projectId, version). Tasks are bound to a specific plan version,
  // and this FK gives Postgres a way to enforce that the bound version actually
  // exists. Cascade-on-delete is intentional: in practice plans are only
  // deleted as part of a project cascade (which already deletes tasks via the
  // existing project FK), so adding the cascade here just makes the behaviour
  // explicit and prevents orphaned tasks if a plan is ever hard-deleted.
  boundTasks       Task[]            @relation("TaskBoundPlan")

  @@unique([projectId, version])
  @@index([projectId, status])
  // R-048 / R-084: a partial unique index `plans_one_active_per_project` is
  // created by a raw-SQL migration to enforce at most one active plan per
  // project. Prisma does not currently support partial unique indexes in the
  // schema DSL, so it is intentionally not declared here. See migration
  // `20260521080000_one_active_plan_per_project` and
  // `packages/api/prisma/migrations/README.md` for the full inventory.
  @@map("plans")
}

model PlanReview {
  id           String   @id @default(cuid())
  planId       String   @map("plan_id")
  reviewerName String   @map("reviewer_name")
  status       String   @default("pending") // pending | approved | rejected
  comment      String?
  focusNotes   String?  @map("focus_notes") // owner-specified review focus for this reviewer
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, reviewerName])
  @@map("plan_reviews")
}

model PlanSuggestion {
  id              String           @id @default(cuid())
  planId          String           @map("plan_id")
  suggestedBy     String           @map("suggested_by")
  suggestedByType String           @map("suggested_by_type") // human | agent
  field           String // goal | scope | constraints | standards | deliverables | openQuestions
  action          String // set | append | remove
  value           String
  reason          String
  status          String           @default("pending") // pending | accepted | rejected | conflict
  resolvedBy      String?          @map("resolved_by")
  resolvedComment String?          @map("resolved_comment")
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")
  // R-155: optional pointer at the specific PlanDeliverable this suggestion
  // is about. Useful when an agent wants to suggest a body / refUri / status
  // change against one item rather than the whole field — UI can render the
  // suggestion inline next to that deliverable's card. Nullable because the
  // legacy "patch the array field" suggestions don't target a single row.
  // SetNull on delete: if the deliverable goes away (e.g. plan rebuilt), the
  // suggestion stays around as historical context but stops linking.
  deliverableId   String?          @map("deliverable_id")
  deliverable     PlanDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@map("plan_suggestions")
}

// R-150: structured plan item tables (additive layer next to Plan.deliverables /
// .constraints / .standards String[] columns). These tables are populated by
// future backfill / dual-write work (R-151+); B13 only lands the schema and
// the relations so downstream features can start being designed against the
// real shape. Until backfill runs the rows are expected to be sparse and the
// String[] columns on `plans` remain the source of truth for plan_show.
//
// All three tables share the same shape (id, planId, slug, body, kind/status,
// timestamps) and a (planId, slug) uniqueness invariant so a stable, human-
// readable slug like `auth/oidc-callback` can be referenced from Task rows,
// drift diffs, and verification rules without leaking row IDs into UI/CLI.
//
// `PlanDeliverable` carries extra fields the deliverable use-case needs:
//   - `title` separate from `body` so list views can be compact
//   - `refType` / `refUri` so a deliverable can point at a file glob, an API
//     spec, a Figma frame, or a Notion page (free-text remains the default)
//   - `status` (`draft|active|done|deprecated`) is independent of plan.status
//     so per-item lifecycle is tracked alongside the surrounding plan version
//   - `supersededById` lets the activate path link the new row to the row it
//     replaces in the previous plan version (self-FK with SetNull on delete
//     so deleting an old plan version does not blow up the new pointer).
model PlanDeliverable {
  id             String   @id @default(cuid())
  planId         String   @map("plan_id")
  slug           String
  title          String
  body           String
  // refType ∈ ('file_glob' | 'api_spec' | 'figma_frame' | 'notion_page' | 'free').
  // Enforced by a CHECK constraint in the migration; kept as String here so
  // adding a new ref kind is a one-migration change without a Prisma enum.
  refType        String?  @map("ref_type")
  refUri         String?  @map("ref_uri")
  // status ∈ ('draft' | 'active' | 'done' | 'deprecated'). CHECK constraint
  // enforced in the migration. Independent of `Plan.status` so a deliverable
  // can be marked `done` while the plan is still being iterated.
  status         String   @default("active")
  supersededById String?  @map("superseded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Cascade)
  supersededBy PlanDeliverable?        @relation("PlanDeliverableSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   PlanDeliverable[]       @relation("PlanDeliverableSupersedes")
  // R-191: back-reference for commit ↔ deliverable links derived from
  // `github_push` events. Each row records that a commit `sha` touched
  // files matched by this deliverable's `refUri` glob, or that the commit
  // message named this deliverable's `slug` explicitly. The link is the
  // foundation for R-192 auto-status (PR merged ∧ commit linked ∧ no
  // drift → done) and the R-193 PR template injection.
  commitLinks  CommitDeliverableLink[]
  // R-153: tasks that explicitly reference this deliverable. Linked by row id
  // (not slug) so renaming `slug` in a future plan version does not silently
  // break drift attribution — the join survives the rename because it is
  // anchored on `id`. The old `Task.planDeliverableRefs` slug array is kept
  // as a derived/legacy column for backwards compatibility; the link rows
  // are the source of truth from now on.
  taskLinks    TaskDeliverableLink[]
  // R-155: PlanSuggestion rows that target this specific deliverable (so the
  // UI can render the suggestion thread inline next to the deliverable
  // card). SetNull on delete on the suggestion side keeps history intact.
  suggestions  PlanSuggestion[]
  // R-156: PlanComment rows that are anchored to this deliverable (per-row
  // discussion thread on the deliverable timeline UI). SetNull on the
  // comment side keeps historical context intact if the deliverable row
  // is later deleted; matches the convention used for `suggestions` above.
  comments     PlanComment[]

  @@unique([planId, slug])
  @@index([planId, status])
  @@map("plan_deliverables")
}

// R-191: commit ↔ deliverable links derived from GitHub `push` events.
//
// Each row records that commit `sha` is associated with deliverable
// `deliverableId`, either because a file in the push matched the
// deliverable's `refUri` glob (`matched_by = 'glob'`) or because the
// commit message contained an explicit `[deliverable:<slug>]` marker
// (`matched_by = 'message'`). The two reasons live as separate rows
// (different `matched_by` values) so the audit trail keeps both
// signals; downstream code reads `match_by='message' OR glob` and
// treats the message form as the stronger signal when ranking.
//
// Lifecycle: the worker (R-162; until that lands, the link function is
// also callable directly from the github webhook route for tests / dev)
// consumes `github_push` outbox events and calls
// `linkCommitsFromPushPayload`, which inserts rows here via the unique
// (sha, deliverable_id, matched_by) constraint so re-delivery of the
// same GitHub event is idempotent. R-192 reads this table to auto-derive
// per-task completion state without trusting agent self-reports.
//
// Project id is denormalised onto the row (instead of joining through
// `plan_deliverables → plans → projects`) so the worker can scope its
// fan-out and the (project_id, sha) index can answer "what touched this
// commit?" in one B-tree hop.
model CommitDeliverableLink {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  sha           String
  deliverableId String   @map("deliverable_id")
  // matchedBy ∈ ('glob' | 'message'). Enforced by a CHECK constraint in
  // the migration; kept as String here so adding a new match reason is
  // a one-migration change without a Prisma enum.
  matchedBy     String   @map("matched_by")
  // The actual evidence: the file path that hit the glob (`matched_by =
  // 'glob'`) or the slug pulled from the commit message (`matched_by =
  // 'message'`). Nullable so future match reasons that have no obvious
  // single-string evidence (e.g. AI semantic similarity) can still land
  // without a schema change.
  matchedRef    String?  @map("matched_ref")
  createdAt     DateTime @default(now()) @map("created_at")

  deliverable PlanDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([sha, deliverableId, matchedBy])
  @@index([projectId, sha])
  @@index([deliverableId])
  @@map("commit_deliverable_links")
}

// R-153: Task → PlanDeliverable many-to-many link.
//
// Why a middle table instead of the existing `Task.planDeliverableRefs:
// String[]` slug list?
//   1. **Rename survives.** PlanDeliverable.slug can be renamed by the owner
//      (or migrated to a new plan version). Linking on `deliverableId` keeps
//      the relationship stable across slug renames, which is exactly the
//      semantics drift-engine needs.
//   2. **Drift severity precision.** R-154 will compute drift severity as
//      "is the linked deliverable present in the new plan version?" — that
//      requires a row-id link, not a free-text slug.
//   3. **Cascade on delete.** Hard-deleting a deliverable should evict the
//      stale link without manual cleanup.
//
// The legacy `Task.planDeliverableRefs` slug array stays around as a
// human-friendly mirror; task_pack derives it from the link rows on read,
// and the write paths sync the link rows whenever the slug list changes.
model TaskDeliverableLink {
  taskId        String   @map("task_id")
  deliverableId String   @map("deliverable_id")
  createdAt     DateTime @default(now()) @map("created_at")

  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverable PlanDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@id([taskId, deliverableId])
  @@index([deliverableId])
  @@map("task_deliverable_links")
}

model PlanConstraint {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  slug      String
  body      String
  // Free-form bucket (e.g. `security`, `performance`, `coding-standards`).
  // Keeping it as String avoids a Prisma enum migration whenever a new
  // category is needed; the API layer is responsible for normalising input.
  kind      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, slug])
  @@index([planId, kind])
  @@map("plan_constraints")
}

model PlanStandard {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  slug      String
  body      String
  kind      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, slug])
  @@index([planId, kind])
  @@map("plan_standards")
}

model PlanComment {
  id            String   @id @default(cuid())
  planId        String   @map("plan_id")
  authorName    String   @map("author_name")
  authorType    String   @map("author_type") // human | agent
  content       String
  parentId      String?  @map("parent_id")
  // R-156: optional pointer to the PlanDeliverable this comment is
  // anchored to. NULL keeps the comment as a top-level plan comment
  // (existing behaviour). SetNull on the deliverable cascade keeps the
  // comment as historical context when a deliverable row is removed; the
  // UI degrades to rendering the comment in the plan-level thread.
  deliverableId String?  @map("deliverable_id")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan        Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  deliverable PlanDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // R-086: be explicit about the self-relation onDelete behaviour. The
  // application uses soft delete (`isDeleted = true`) for comments, so a hard
  // delete of a parent comment that still has replies should be rejected to
  // avoid silently orphaning the thread (which is what the implicit Prisma
  // default of `SetNull` previously did). Plan deletion still cascades the
  // whole thread away because the `plan` relation above is `Cascade` and
  // Postgres evaluates the cascade for the entire subtree in one statement.
  parent      PlanComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replies     PlanComment[]    @relation("CommentReplies")

  @@index([deliverableId])
  @@map("plan_comments")
}

model Task {
  id                  String    @id @default(cuid())
  projectId           String    @map("project_id")
  title               String
  description         String?
  type                String // code | research | design | bug | refactor
  priority            String    @default("p1") // p0 | p1 | p2
  status              String    @default("todo") // todo | in_progress | blocked | done | cancelled | awaiting_evidence (R-192)
  // R-140: when non-null, system has gated execution on this task. The task
  // status field stays untouched ('todo'/'in_progress') so the owner can
  // distinguish "system-blocked because plan drifted" from "owner manually
  // blocked / failed run" (the latter still uses status='blocked'). Values:
  //   null              — no gate, execution_start may proceed.
  //   drift_high        — high-severity drift; gate cleared by drift_resolve.
  //   drift_medium      — medium-severity drift; gate cleared by drift_resolve.
  //   manual_block      — reserved for owner-initiated blocks (not used yet,
  //                       kept in the enum so future work need not migrate).
  executionGate       String?   @map("execution_gate")
  assignee            String?
  assigneeType        String    @default("unassigned") @map("assignee_type") // human | agent | unassigned
  boundPlanVersion    Int       @map("bound_plan_version")
  branchName          String?   @map("branch_name")
  prUrl               String?   @map("pr_url")
  agentContext        String?   @map("agent_context")
  expectedOutput      String?   @map("expected_output")
  agentConstraints    String[]  @map("agent_constraints")
  planDeliverableRefs String[]  @default([]) @map("plan_deliverable_refs")
  // Drift v2: which plan constraint / standard items this task depends on.
  // Empty array is interpreted by the severity classifier as "depends on
  // all" (the conservative default), so existing rows behave exactly as
  // before until an owner narrows them.
  planConstraintRefs  String[]  @default([]) @map("plan_constraint_refs")
  planStandardRefs    String[]  @default([]) @map("plan_standard_refs")
  startDate           DateTime? @map("start_date")
  dueDate             DateTime? @map("due_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // R-083: composite FK to plans(projectId, version). The same `projectId`
  // column participates in two relations (Project + Plan); Prisma allows this
  // as long as the relations are otherwise unambiguous. The relation is named
  // so the back-reference on Plan (`boundTasks`) can be wired up explicitly.
  // onDelete: Cascade matches the existing project-cascade chain — when a
  // project is deleted, its plans and tasks cascade independently, and adding
  // a plan-side cascade here keeps the constraint satisfied regardless of the
  // (undefined) order Postgres evaluates the two cascades.
  boundPlan        Plan                  @relation("TaskBoundPlan", fields: [projectId, boundPlanVersion], references: [projectId, version], onDelete: Cascade, onUpdate: Cascade)
  executionRuns    ExecutionRun[]
  driftAlerts      DriftAlert[]
  // R-153: many-to-many link to PlanDeliverable. The legacy
  // `planDeliverableRefs: String[]` column above is kept as a derived
  // (denormalised) projection for backwards compatibility — read paths now
  // join through this relation and write paths sync both sides atomically.
  deliverableLinks TaskDeliverableLink[]

  // R-075: composite indexes to back hot task-list queries
  // (listing tasks by status, my-work / assignee lookups).
  @@index([projectId, status])
  @@index([projectId, assignee])
  // R-083: index backing the composite FK above so the FK lookup and
  // cascade-on-delete from Plan stay on a B-tree path.
  @@index([projectId, boundPlanVersion])
  @@map("tasks")
}

model ExecutionRun {
  id               String    @id @default(cuid())
  taskId           String    @map("task_id")
  executorType     String    @map("executor_type") // human | agent
  executorName     String    @map("executor_name")
  boundPlanVersion Int       @map("bound_plan_version")
  status           String    @default("running") // running | completed | failed | cancelled | stale | superseded
  taskPackSnapshot Json      @map("task_pack_snapshot")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  outputSummary    String?   @map("output_summary")
  filesChanged     String[]  @map("files_changed")
  branchName       String?   @map("branch_name")
  blockers         String[]
  driftSignals     String[]  @map("drift_signals")
  deliverablesMet  String[]  @default([]) @map("deliverables_met")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")

  // R-143: completion-verify observability. Each call to the AI completion
  // verifier writes its score/breakdown/feedback/model back onto the run so
  // the owner can see *why* a 422 happened (or that the AI was unavailable
  // and the run was allowed through). The 422 response also echoes runId so
  // the UI can deep-link to the failed verification record.
  aiVerifyScore     Float?  @map("ai_verify_score")
  aiVerifyBreakdown Json?   @map("ai_verify_breakdown")
  aiVerifyFeedback  String? @map("ai_verify_feedback")
  aiVerifyModel     String? @map("ai_verify_model")

  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  apiKeys ApiKey[]
  // R-180: advisory verification reviews. Each row records the outcome of a
  // completion verification gate (today only `kind = 'ai_verification'`, but
  // R-181 will add rule-based gates that also write here). Multiple rows per
  // run are allowed so retries / re-verifications can stack chronologically.
  reviews RunReview[]

  // R-084: a partial unique index `execution_runs_one_running_per_task` is
  // created by a raw-SQL migration to enforce at most one running run per
  // task. Prisma does not currently support partial unique indexes in the
  // schema DSL, so it is intentionally not declared here. See migration
  // `20260421000000_one_running_run_per_task` and
  // `packages/api/prisma/migrations/README.md` for the full inventory.
  //
  // (Historical note: a previous comment cross-referenced R-049 — that ID
  //  belongs to the unrelated B6 work item "task_claim conditional
  //  updateMany atomicity" and was attached to this index in error.)
  @@map("execution_runs")
}

// R-180: advisory verification record. Before R-180, completion-verify
// returned HTTP 422 when the AI scored a run < 75 — which blocked the run
// from being marked `completed` even when the human owner disagreed with the
// model. The new contract is: complete always succeeds, and the AI score /
// feedback are persisted here as an *advisory* review so the owner UI can
// surface them and (per R-181) optional rule-based gates can layer on top
// without changing this contract.
//
// `kind` is intentionally a String (not a Prisma enum) so R-181's rule
// evaluator can add new advisory kinds (`require_files_changed`,
// `min_output_summary_chars`, …) without a schema migration.
//
// `metadata` carries kind-specific structured data (for `ai_verification`:
// breakdown sub-scores + provider model name). The route also continues to
// write the AI score / breakdown / feedback / model onto the ExecutionRun
// columns from R-143 so existing dashboards / queries keep working — this
// table is the new authoritative source going forward.
model RunReview {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  // ai_verification — score+feedback came from `aiClient.complete`.
  // Future R-181 kinds: rule_files_changed, rule_min_output_chars, etc.
  kind      String
  score     Float?
  feedback  String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  run ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt(sort: Desc)])
  @@map("run_reviews")
}

model DriftAlert {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  taskId             String    @map("task_id")
  type               String    @default("version_mismatch") // version_mismatch
  // R-087: explicit default keeps the column NOT NULL even if a future
  // code path forgets to set severity. "medium" matches the conservative
  // bucket used by severityToDb when neither structural nor execution
  // signals push it to "high".
  severity           String    @default("medium") // high | medium | low
  reason             String
  status             String    @default("open") // open | resolved
  // R-051: enforced by partial unique index `drift_alerts_one_open_per_task`
  // (migration 20260523100000) — at most one row per task_id may have
  // status='open'. `persistDriftAlerts` supersedes prior open rows with
  // resolvedAction='superseded' before creating new ones, so repeated plan
  // activations no longer accumulate duplicate alerts on the same task.
  resolvedAction     String?   @map("resolved_action") // rebind | cancel | no_impact | superseded
  currentPlanVersion Int       @map("current_plan_version")
  taskBoundVersion   Int       @map("task_bound_version")
  compatibilityScore Float?    @map("compatibility_score")
  impactAnalysis     String?   @map("impact_analysis")
  suggestedAction    String?   @map("suggested_action")
  affectedAreas      String[]  @default([]) @map("affected_areas")
  planDiffId         String?   @map("plan_diff_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")
  resolvedBy         String?   @map("resolved_by")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // R-081: planDiffId references plan_diffs(id). Use SetNull so deleting a
  // PlanDiff (e.g. during cleanup) does not cascade-delete drift history; the
  // alert remains visible with a null reference instead.
  planDiff PlanDiff? @relation(fields: [planDiffId], references: [id], onDelete: SetNull)

  // R-076: composite indexes to back hot drift queries
  // (per-project drift listing filtered by status, per-task drift lookups).
  @@index([projectId, status])
  @@index([taskId, status])
  @@map("drift_alerts")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  type      String
  actorName String   @map("actor_name")
  actorType String   @map("actor_type") // human | agent | system
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("activities")
}

model ApiKey {
  id          String        @id @default(cuid())
  // R-085: every column on this table now has an explicit `@map` so the DB
  // uses snake_case identifiers consistently with the rest of the schema.
  projectId   String?       @map("project_id") // nullable: null for global web-session keys
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String        @map("key_hash")
  keyPrefix   String        @map("key_prefix")
  permissions String[]
  createdBy   String        @map("created_by")
  lastUsedAt  DateTime?     @map("last_used_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  execRunId   String?       @map("exec_run_id")
  // R-080: relate exec-scoped keys to their run so the row is preserved (with
  // execRunId nulled) when the run record is removed instead of leaving a
  // dangling reference.
  execRun     ExecutionRun? @relation(fields: [execRunId], references: [id], onDelete: SetNull)
  expiresAt   DateTime?     @map("expires_at")

  @@index([execRunId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(cuid())
  // R-085: snake_case `@map` for every column.
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  events    String[]
  secret    String?
  active    Boolean  @default(true)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]
  jobs       WebhookJob[]

  @@map("webhooks")
}

// R-139: persistent webhook retry queue. Before R-139 the 0s/1s/5s/30s
// backoff between attempts lived entirely in `setTimeout` chains inside
// `deliverWithRetry`. An API restart mid-backoff dropped every in-flight
// retry: the row was never written, the receiver never saw a 200, and
// the user was told "delivered" because the foreground request had
// already returned. With this table the dispatcher writes one durable
// job per webhook subscription per event and a dedicated worker
// (`webhook-worker.ts`) is the only thing that performs HTTP — so a
// process restart loses at most the in-flight HTTP request, not the
// retry schedule.
//
// Status values are intentionally narrow strings (not a Prisma enum) so
// the migration stays additive and the worker can grow new states
// (`paused`, `cancelled`, ...) without a schema migration.
//   - pending   — visible to the worker once `nextAttemptAt <= now()`.
//   - in_flight — worker has claimed the row for HTTP. Reset to
//     `pending` (with a fresh `nextAttemptAt`) on retry, or finalised to
//     `delivered` / `failed` once the attempt is done.
//   - delivered — terminal success.
//   - failed    — terminal failure after `MAX_ATTEMPTS` attempts (or a
//     non-recoverable error such as the parent webhook being inactive).
model WebhookJob {
  id            String   @id @default(cuid())
  webhookId     String   @map("webhook_id")
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  body          Json
  attempt       Int      @default(0)
  status        String   @default("pending")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // The worker's hot query is "find the next pending job whose backoff has
  // elapsed". A composite index on (status, next_attempt_at) keeps that
  // query index-only even when the historical table grows large.
  @@index([status, nextAttemptAt])
  @@index([webhookId])
  @@map("webhook_jobs")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  // R-085: snake_case `@map` for every column.
  webhookId    String   @map("webhook_id")
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  requestBody  Json     @map("request_body")
  responseCode Int      @map("response_code")
  success      Boolean
  errorMessage String?  @map("error_message")
  attempt      Int
  createdAt    DateTime @default(now()) @map("created_at")

  // R-078: paginate per-webhook delivery history newest-first.
  // Backs queries like `findMany({ where: { webhookId }, orderBy: { createdAt: 'desc' } })`.
  @@index([webhookId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// R-new3 / closes #1005 — idempotency record for INBOUND webhook
/// deliveries (e.g. GitHub's X-GitHub-Delivery). The webhook route
/// inserts a row in the same transaction as the outbox writes; the
/// unique([source, deliveryId]) constraint causes a P2002 on the
/// SECOND attempt with the same delivery, letting the receiver
/// short-circuit with 200 rather than producing duplicate outbox
/// rows on a retried delivery.
model InboundWebhookDelivery {
  id         String   @id @default(cuid())
  source     String
  deliveryId String   @map("delivery_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([source, deliveryId])
  @@index([receivedAt])
  @@map("inbound_webhook_deliveries")
}

model PlanDiff {
  id          String   @id @default(cuid())
  // R-085: snake_case `@map` for every column.
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPlanId  String   @map("from_plan_id")
  toPlanId    String   @map("to_plan_id")
  // R-082: explicit FKs to plans so dangling diffs can never reference a
  // missing plan row. Cascade matches the Project relation above and means
  // a diff disappears if either of its endpoints is removed.
  fromPlan    Plan     @relation("PlanDiffFromPlan", fields: [fromPlanId], references: [id], onDelete: Cascade)
  toPlan      Plan     @relation("PlanDiffToPlan", fields: [toPlanId], references: [id], onDelete: Cascade)
  changes     Json
  generatedAt DateTime @default(now()) @map("generated_at")

  // R-081: drift alerts reference plan_diffs(id) via DriftAlert.planDiffId.
  driftAlerts DriftAlert[]

  @@unique([fromPlanId, toPlanId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@map("plan_diffs")
}

model UserAccount {
  id           String   @id @default(cuid())
  userName     String   @unique @map("user_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_accounts")
}

model UserState {
  userName           String    @id @map("user_name")
  lastSeenActivityAt DateTime? @map("last_seen_activity_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_state")
}

// R-182 (supersedes R-144): one row per LLM call (success or failure).
// Backs `/api/ai-usage` aggregation and R-183 caching keyed off `inputHash`.
// All token-count columns are nullable because providers may omit them and
// failed calls have nothing to report.
model AiCall {
  id            String   @id @default(cuid())
  purpose       String
  provider      String
  model         String
  promptHash    String   @map("prompt_hash")
  inputHash     String   @map("input_hash")
  outputHash    String?  @map("output_hash")
  promptVersion String   @default("v1") @map("prompt_version")
  latencyMs     Int      @map("latency_ms")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  ok            Boolean
  errorCode     String?  @map("error_code")
  cacheHit      Boolean  @default(false) @map("cache_hit")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([purpose, createdAt(sort: Desc)])
  @@index([inputHash, purpose])
  @@index([createdAt(sort: Desc)])
  @@map("ai_calls")
}

// R-181: declarative, owner-configurable verification rules that act as a
// HARD gate at `complete` time. R-180 demoted the AI scoring path to an
// advisory (no more 422 from the AI), and this table now holds the rule
// engine that *can* 422 a complete — but only on deterministic, owner-
// editable conditions instead of "the LLM gave you a B-".
//
// Scope semantics:
//   - scope = 'project'         — applies to every run in the project.
//   - scope = 'task_type'       — applies only when task.type === scopeValue
//                                  (e.g. enforce `require_files_changed`
//                                  for code tasks but not research tasks).
//   - scope = 'task'            — applies only when run.taskId === scopeValue
//                                  (rare; useful for one-off escalations).
//
// `kind` is a String (not a Prisma enum) so a new rule kind is a one-file
// evaluator change without a schema migration. Today the evaluator supports:
//   - require_files_changed             — body.filesChanged must be non-empty
//   - require_commits_on_branch         — body.branchName must be set + non-empty
//   - require_pr_merged                 — body.prUrl must be set + non-empty
//   - require_deliverable_evidence_for_each_ref
//                                       — every plan deliverable ref on the
//                                         task must appear as a substring of
//                                         at least one deliverablesMet entry
//   - min_output_summary_chars          — body.outputSummary length ≥ params.min
//
// `enabled` lets owners temporarily disable a rule without deleting it;
// the evaluator skips disabled rows. `params` is the per-kind bag (e.g.
// `{ min: 40 }` for min_output_summary_chars).
model VerificationRule {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  scope      String   @default("project") // project | task_type | task
  scopeValue String?  @map("scope_value")
  kind       String
  params     Json     @default("{}")
  enabled    Boolean  @default(true)
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Hot read path: "list all enabled rules for this project on complete".
  // The evaluator filters by scope/scopeValue in memory after this fetch
  // because the projectId,enabled index keeps the candidate set small
  // (typical owner configures < 20 rules per project).
  @@index([projectId, enabled])
  @@map("verification_rules")
}

// R-160: transactional outbox. Every state-changing event is written to this
// table inside the same DB transaction that produced the state change. A
// separate worker (R-162) consumes rows where deliveredAt IS NULL and fans
// them out to existing sinks (SSE, webhook, email, activity). The bigserial
// id provides a monotonic sequence for SSE lastEventId replay (R-163).
model DomainEvent {
  id          BigInt    @id @default(autoincrement())
  eventType   String    @map("event_type")
  projectId   String?   @map("project_id")
  userName    String?   @map("user_name")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")
  attempt     Int       @default(0)

  // Backs the consumer's hot path:
  //   SELECT ... WHERE delivered_at IS NULL ORDER BY id ASC FOR UPDATE SKIP LOCKED
  // The migration creates this as a partial index (`WHERE delivered_at IS NULL`)
  // so it only contains rows the worker actually needs to scan; prisma does not
  // model partial indexes, so the @@index here is a no-op placeholder that the
  // migration replaces with the real partial index.
  @@index([deliveredAt, id])
  @@map("domain_events")
}

// R-136: audit trail + TTL store for master-delegation (PLANSYNC_SECRET)
// usage. One row per delegation episode (not per request — the
// recordMasterDelegation helper reuses the most recent unexpired row for
// the same (callerIp, targetUser) pair if it's < 5 min old, so a chatty
// agent doesn't fill the table). expiresAt is computed at INSERT time as
// `now() + PLANSYNC_MASTER_DELEGATION_TTL_MIN`. The 10-min heartbeat
// scanner garbage-collects rows where expiresAt < now() - interval '7 days'.
model MasterDelegation {
  id          String   @id @default(cuid())
  callerIp    String   @map("caller_ip")
  callerUa    String   @map("caller_ua")
  targetUser  String   @map("target_user")
  routeMethod String   @map("route_method")
  routePath   String   @map("route_path")
  occurredAt  DateTime @default(now()) @map("occurred_at")
  expiresAt   DateTime @map("expires_at")

  // Audit query path — owner-facing "what happened to <user>".
  @@index([targetUser, occurredAt(sort: Desc)])
  // GC scanner path — range-scan by retention boundary.
  @@index([expiresAt])
  // 5-min reuse window lookup.
  @@index([callerIp, targetUser, occurredAt(sort: Desc)], map: "master_delegations_caller_target_occurred_idx")
  @@map("master_delegations")
}
