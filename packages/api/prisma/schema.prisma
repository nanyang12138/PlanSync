generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  phase         String   @default("planning") // planning | active | completed
  repoUrl       String?  @map("repo_url")
  defaultBranch String?  @map("default_branch")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members     ProjectMember[]
  plans       Plan[]
  tasks       Task[]
  driftAlerts DriftAlert[]
  activities  Activity[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  planDiffs   PlanDiff[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  role      String   @default("developer") // owner | developer
  type      String   @default("human") // human | agent
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_members")
}

model Plan {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  version           Int
  status            String    @default("draft") // draft | proposed | active | superseded
  title             String
  goal              String
  scope             String
  constraints       String[]
  standards         String[]
  deliverables      String[]
  openQuestions     String[]  @map("open_questions")
  changeSummary     String?   @map("change_summary")
  why               String?
  requiredReviewers String[]  @map("required_reviewers")
  createdBy         String    @map("created_by")
  activatedAt       DateTime? @map("activated_at")
  activatedBy       String?   @map("activated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews     PlanReview[]
  suggestions PlanSuggestion[]
  comments    PlanComment[]
  // R-082: back-references for PlanDiff FK constraints; if a plan is deleted
  // (only drafts can be deleted today), any cached diffs referencing it are
  // cascaded away because they are meaningless without the underlying plan.
  diffsFrom   PlanDiff[]       @relation("PlanDiffFromPlan")
  diffsTo     PlanDiff[]       @relation("PlanDiffToPlan")

  @@unique([projectId, version])
  @@index([projectId, status])
  // R-048 / R-084: a partial unique index `plans_one_active_per_project` is
  // created by a raw-SQL migration to enforce at most one active plan per
  // project. Prisma does not currently support partial unique indexes in the
  // schema DSL, so it is intentionally not declared here. See migration
  // `20260521080000_one_active_plan_per_project` and
  // `packages/api/prisma/migrations/README.md` for the full inventory.
  @@map("plans")
}

model PlanReview {
  id           String   @id @default(cuid())
  planId       String   @map("plan_id")
  reviewerName String   @map("reviewer_name")
  status       String   @default("pending") // pending | approved | rejected
  comment      String?
  focusNotes   String?  @map("focus_notes") // owner-specified review focus for this reviewer
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, reviewerName])
  @@map("plan_reviews")
}

model PlanSuggestion {
  id              String    @id @default(cuid())
  planId          String    @map("plan_id")
  suggestedBy     String    @map("suggested_by")
  suggestedByType String    @map("suggested_by_type") // human | agent
  field           String // goal | scope | constraints | standards | deliverables | openQuestions
  action          String // set | append | remove
  value           String
  reason          String
  status          String    @default("pending") // pending | accepted | rejected | conflict
  resolvedBy      String?   @map("resolved_by")
  resolvedComment String?   @map("resolved_comment")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_suggestions")
}

model PlanComment {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  authorName String   @map("author_name")
  authorType String   @map("author_type") // human | agent
  content    String
  parentId   String?  @map("parent_id")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan    Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  // R-086: be explicit about the self-relation onDelete behaviour. The
  // application uses soft delete (`isDeleted = true`) for comments, so a hard
  // delete of a parent comment that still has replies should be rejected to
  // avoid silently orphaning the thread (which is what the implicit Prisma
  // default of `SetNull` previously did). Plan deletion still cascades the
  // whole thread away because the `plan` relation above is `Cascade` and
  // Postgres evaluates the cascade for the entire subtree in one statement.
  parent  PlanComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replies PlanComment[] @relation("CommentReplies")

  @@map("plan_comments")
}

model Task {
  id                  String    @id @default(cuid())
  projectId           String    @map("project_id")
  title               String
  description         String?
  type                String // code | research | design | bug | refactor
  priority            String    @default("p1") // p0 | p1 | p2
  status              String    @default("todo") // todo | in_progress | blocked | done | cancelled
  assignee            String?
  assigneeType        String    @default("unassigned") @map("assignee_type") // human | agent | unassigned
  boundPlanVersion    Int       @map("bound_plan_version")
  branchName          String?   @map("branch_name")
  prUrl               String?   @map("pr_url")
  agentContext        String?   @map("agent_context")
  expectedOutput      String?   @map("expected_output")
  agentConstraints    String[]  @map("agent_constraints")
  planDeliverableRefs String[]  @default([]) @map("plan_deliverable_refs")
  // Drift v2: which plan constraint / standard items this task depends on.
  // Empty array is interpreted by the severity classifier as "depends on
  // all" (the conservative default), so existing rows behave exactly as
  // before until an owner narrows them.
  planConstraintRefs  String[]  @default([]) @map("plan_constraint_refs")
  planStandardRefs    String[]  @default([]) @map("plan_standard_refs")
  startDate           DateTime? @map("start_date")
  dueDate             DateTime? @map("due_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionRuns ExecutionRun[]
  driftAlerts   DriftAlert[]

  // R-075: composite indexes to back hot task-list queries
  // (listing tasks by status, my-work / assignee lookups).
  @@index([projectId, status])
  @@index([projectId, assignee])
  @@map("tasks")
}

model ExecutionRun {
  id               String    @id @default(cuid())
  taskId           String    @map("task_id")
  executorType     String    @map("executor_type") // human | agent
  executorName     String    @map("executor_name")
  boundPlanVersion Int       @map("bound_plan_version")
  status           String    @default("running") // running | completed | failed | cancelled | stale | superseded
  taskPackSnapshot Json      @map("task_pack_snapshot")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  outputSummary    String?   @map("output_summary")
  filesChanged     String[]  @map("files_changed")
  branchName       String?   @map("branch_name")
  blockers         String[]
  driftSignals     String[]  @map("drift_signals")
  deliverablesMet  String[]  @default([]) @map("deliverables_met")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")

  // R-143: completion-verify observability. Each call to the AI completion
  // verifier writes its score/breakdown/feedback/model back onto the run so
  // the owner can see *why* a 422 happened (or that the AI was unavailable
  // and the run was allowed through). The 422 response also echoes runId so
  // the UI can deep-link to the failed verification record.
  aiVerifyScore     Float?  @map("ai_verify_score")
  aiVerifyBreakdown Json?   @map("ai_verify_breakdown")
  aiVerifyFeedback  String? @map("ai_verify_feedback")
  aiVerifyModel     String? @map("ai_verify_model")

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  apiKeys ApiKey[]

  // R-049 / R-084: a partial unique index `execution_runs_one_running_per_task`
  // is created by a raw-SQL migration to enforce at most one running run per
  // task. Prisma does not currently support partial unique indexes in the
  // schema DSL, so it is intentionally not declared here. See migration
  // `20260421000000_one_running_run_per_task` and
  // `packages/api/prisma/migrations/README.md` for the full inventory.
  @@map("execution_runs")
}

model DriftAlert {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  taskId             String    @map("task_id")
  type               String    @default("version_mismatch") // version_mismatch
  severity           String // high | medium | low
  reason             String
  status             String    @default("open") // open | resolved
  resolvedAction     String?   @map("resolved_action") // rebind | cancel | no_impact
  currentPlanVersion Int       @map("current_plan_version")
  taskBoundVersion   Int       @map("task_bound_version")
  compatibilityScore Float?    @map("compatibility_score")
  impactAnalysis     String?   @map("impact_analysis")
  suggestedAction    String?   @map("suggested_action")
  affectedAreas      String[]  @default([]) @map("affected_areas")
  planDiffId         String?   @map("plan_diff_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")
  resolvedBy         String?   @map("resolved_by")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // R-081: planDiffId references plan_diffs(id). Use SetNull so deleting a
  // PlanDiff (e.g. during cleanup) does not cascade-delete drift history; the
  // alert remains visible with a null reference instead.
  planDiff PlanDiff? @relation(fields: [planDiffId], references: [id], onDelete: SetNull)

  // R-076: composite indexes to back hot drift queries
  // (per-project drift listing filtered by status, per-task drift lookups).
  @@index([projectId, status])
  @@index([taskId, status])
  @@map("drift_alerts")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  type      String
  actorName String   @map("actor_name")
  actorType String   @map("actor_type") // human | agent | system
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("activities")
}

model ApiKey {
  id          String        @id @default(cuid())
  projectId   String? // nullable: null for global web-session keys
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String
  keyPrefix   String
  permissions String[]
  createdBy   String
  lastUsedAt  DateTime?
  createdAt   DateTime      @default(now())
  execRunId   String?       @map("exec_run_id")
  // R-080: relate exec-scoped keys to their run so the row is preserved (with
  // execRunId nulled) when the run record is removed instead of leaving a
  // dangling reference.
  execRun     ExecutionRun? @relation(fields: [execRunId], references: [id], onDelete: SetNull)
  expiresAt   DateTime?     @map("expires_at")

  @@index([execRunId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  events    String[]
  secret    String?
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  requestBody  Json
  responseCode Int
  success      Boolean
  errorMessage String?
  attempt      Int
  createdAt    DateTime @default(now())

  // R-078: paginate per-webhook delivery history newest-first.
  // Backs queries like `findMany({ where: { webhookId }, orderBy: { createdAt: 'desc' } })`.
  @@index([webhookId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model PlanDiff {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPlanId  String
  toPlanId    String
  // R-082: explicit FKs to plans so dangling diffs can never reference a
  // missing plan row. Cascade matches the Project relation above and means
  // a diff disappears if either of its endpoints is removed.
  fromPlan    Plan     @relation("PlanDiffFromPlan", fields: [fromPlanId], references: [id], onDelete: Cascade)
  toPlan      Plan     @relation("PlanDiffToPlan", fields: [toPlanId], references: [id], onDelete: Cascade)
  changes     Json
  generatedAt DateTime @default(now())

  // R-081: drift alerts reference plan_diffs(id) via DriftAlert.planDiffId.
  driftAlerts DriftAlert[]

  @@unique([fromPlanId, toPlanId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@map("plan_diffs")
}

model UserAccount {
  id           String   @id @default(cuid())
  userName     String   @unique @map("user_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_accounts")
}

model UserState {
  userName           String    @id @map("user_name")
  lastSeenActivityAt DateTime? @map("last_seen_activity_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_state")
}
