{
  "permissions": {
    "allow": ["mcp__plansync__*"]
  },
  "enableAllProjectMcpServers": true,
  "mcpServers": {
    "plansync": {
      "command": "bin/start-mcp",
      "args": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "bin/plansync abort-check" }]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true
  }
}
