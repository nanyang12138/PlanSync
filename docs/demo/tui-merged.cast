[550.346744, "o", "\u001b[H  \u001b[35m\u001b[1m\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2557      \u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2557   \u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2557   \u2588\u2588\u2557\u2588\u2588\u2588\u2557   \u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2557\u001b(B\u001b[m\u001b[20X\r\n  \u001b[35m\u001b[1m\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2551     \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u255a\u2588\u2588\u2557 \u2588\u2588\u2554\u255d\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u001b(B\u001b[m\u001b[20X\r\n  \u001b[35m\u001b[1m\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u2588\u2588\u2551     \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2554\u2588\u2588\u2557 \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u255a\u2588\u2588\u2588\u2588\u2554\u255d \u2588\u2588\u2554\u2588\u2588\u2557 \u2588\u2588\u2551\u2588\u2588\u2551     \u001b(B\u001b[m\u001b[20X\r\n  \u001b[35m\u001b[1m\u2588\u2588\u2554\u2550\u2550\u2550\u255d \u2588\u2588\u2551     \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u2588\u2588\u2551\u255a\u2588\u2588\u2557\u2588\u2588\u2551\u255a\u2550\u2550\u2550\u2550\u2588\u2588\u2551  \u255a\u2588\u2588\u2554\u255d  \u2588\u2588\u2551\u255a\u2588\u2588\u2557\u2588\u2588\u2551\u2588\u2588\u2551     \u001b(B\u001b[m\u001b[20X\r\n  \u001b[35m\u001b[1m\u2588\u2588\u2551     \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551 \u255a\u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551   \u2588\u2588\u2551   \u2588\u2588\u2551 \u255a\u2588\u2588\u2588\u2588\u2551\u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u001b(B\u001b[m\u001b[20X\r\n  \u001b[35m\u001b[1m\u255a\u2550\u255d     \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u2550\u2550\u255d\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d   \u255a\u2550\u255d   \u255a\u2550\u255d  \u255a\u2550\u2550\u2550\u255d \u255a\u2550\u2550\u2550\u2550\u2550\u255d\u001b(B\u001b[m\u001b[20X\u001b[7;91H\u001b[1K\r  \u001b[2mWhere Plans Meet Execution\u001b(B\u001b[m\u001b[8;91H\u001b[1K\n\u001b[1K\r                                        \u001b[10;91H\u001b[1K\r  \u001b[1mSelect a project:\u001b(B\u001b[m\u001b[11;91H\u001b[1K\n\u001b[1K\r  \u001b[36m1\u001b[39m. \u001b[1mPayFlow\u001b(B\u001b[m\u001b[13;91H\u001b[1K\r  \u001b[36m2\u001b[39m. \u001b[1mPlanSync Demo\u001b(B\u001b[m\u001b[14;91H\u001b[1K\r  \u001b[36mn\u001b[39m. \u001b[2mCreate new project\u001b(B\u001b[m\u001b[15;91H\u001b[1K\r  \u001b[36md\u001b[39m. \u001b[2mDelete a project\u001b(B\u001b[m\u001b[16;91H\u001b[1K\n\u001b[1K\r  Enter number [1-2], n, or d: 1\u001b[18;91H\u001b[1K\r  \u001b[32m\u2713 Selected: PayFlow\u001b[39m\u001b[19;91H\u001b[1K\r                                        \r\n  \u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e  \u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[36m\u001b[1mPlanSync Terminal\u001b(B\u001b[m                            \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[1mQuick Tips\u001b(B\u001b[m                 \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[2malice\u001b(B\u001b[m                                        \u001b[2m\u2502  \u2502\u001b(B\u001b[m                             \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m                                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mChat with AI naturally\u001b(B\u001b[m     \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mProject\u001b[39m\u001b[1mPayFlow\u001b(B\u001b[m                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2m! for shell commands\u001b(B\u001b[m       \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mPlan   \u001b[36mv1\u001b[39m  \u001b[2m\"\u652f\u4ed8\u6d41\u7a0b v1\"\u001b(B\u001b[m                         \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mTab to autocomplete /cmds\u001b(B\u001b[m  \u001b[2m\u2502\u001b(B\u001b[m\u001b[3X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mPhase  \u001b[39m\u001b[1m\u001b[2m[planning]\u001b(B\u001b[m \u001b[2m\u2192\u001b(B\u001b[m \u001b[2mactive\u001b(B\u001b[m \u001b[2m\u2192\u001b(B\u001b[m \u001b[2mcompleted\u001b(B\u001b[m       \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m  \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mTasks  \u001b[39m\u001b[2m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b(B\u001b[m  \u001b[2m0/2\u001b(B\u001b[m  \u001b[2m0\u25b6\u001b(B\u001b[m  \u001b[32m\u2713 no drift\u001b[39m       \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[1mRecent Activity\u001b(B\u001b[m            \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m                                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m                             \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[33m\u25b8\u001b[39m  \u001b[36mType: \"/tasks\" to pick a task and start\u001b[39m   \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mNo recent activity\u001b(B\u001b[m         \u001b[2m\u2502\u001b(B\u001b[m\u001b[7X\r\n  \u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b(B\u001b[m\u001b[7X\u001b[31;91H\u001b[1K\r\n  \u001b[2mChat with PlanSync AI.  /help for all commands\u001b(B\u001b[m\u001b[43X\u001b[33;91H\u001b[1K\u001b[2m\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
