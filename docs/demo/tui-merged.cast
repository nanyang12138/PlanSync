[550.768691, "o", "\u001b[?25l\u001b[1d  \u001b[35m\u001b[1m\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2557      \u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2557   \u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2557   \u2588\u2588\u2557\u2588\u2588\u2588\u2557   \u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2557\u001b(B\u001b[m\u001b[K\u001b[2;93H  \u001b[35m\u001b[1m\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2551     \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u255a\u2588\u2588\u2557 \u2588\u2588\u2554\u255d\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u001b(B\u001b[m\u001b[K\u001b[3;93H  \u001b[35m\u001b[1m\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u2588\u2588\u2551     \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2554\u2588\u2588\u2557 \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u255a\u2588\u2588\u2588\u2588\u2554\u255d \u2588\u2588\u2554\u2588\u2588\u2557 \u2588\u2588\u2551\u2588\u2588\u2551     \u001b(B\u001b[m\u001b[K\u001b[4;93H  \u001b[35m\u001b[1m\u2588\u2588\u2554\u2550\u2550\u2550\u255d \u2588\u2588\u2551     \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u2588\u2588\u2551\u255a\u2588\u2588\u2557\u2588\u2588\u2551\u255a\u2550\u2550\u2550\u2550\u2588\u2588\u2551  \u255a\u2588\u2588\u2554\u255d  \u2588\u2588\u2551\u255a\u2588\u2588\u2557\u2588\u2588\u2551\u2588\u2588\u2551     \u001b(B\u001b[m\u001b[K\u001b[5;93H  \u001b[35m\u001b[1m\u2588\u2588\u2551     \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551 \u255a\u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551   \u2588\u2588\u2551   \u2588\u2588\u2551 \u255a\u2588\u2588\u2588\u2588\u2551\u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u001b(B\u001b[m\u001b[K\u001b[6;93H  \u001b[35m\u001b[1m\u255a\u2550\u255d     \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u2550\u2550\u255d\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d   \u255a\u2550\u255d   \u255a\u2550\u255d  \u255a\u2550\u2550\u2550\u255d \u255a\u2550\u2550\u2550\u2550\u2550\u255d\u001b(B\u001b[m\u001b[K\u001b[7;93H  \u001b[2mWhere Plans Meet Execution\u001b(B\u001b[m\u001b[K\u001b[8;93H\u001b[K\n                                        \u001b[K\u001b[10;93H  \u001b[1mSelect a project:\u001b(B\u001b[m\u001b[K\u001b[11;93H\u001b[K\n  \u001b[36m1\u001b[39m. \u001b[1mPayFlow\u001b(B\u001b[m\u001b[K\u001b[13;93H  \u001b[36m2\u001b[39m. \u001b[1mPlanSync Demo\u001b(B\u001b[m\u001b[K\u001b[14;93H  \u001b[36mn\u001b[39m. \u001b[2mCreate new project\u001b(B\u001b[m\u001b[K\u001b[15;93H  \u001b[36md\u001b[39m. \u001b[2mDelete a project\u001b(B\u001b[m\u001b[K\u001b[16;93H\u001b[K\n  Enter number [1-2], n, or d: 1\u001b[K\u001b[18;93H  \u001b[32m\u2713 Selected: PayFlow\u001b[39m\u001b[K\u001b[19;93H                                        \u001b[K\u001b[20;93H  \u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e  \u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b(B\u001b[m\u001b[K\u001b[21;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[36m\u001b[1mPlanSync Terminal\u001b(B\u001b[m                            \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[1mQuick Tips\u001b(B\u001b[m                 \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[22;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[2mbob\u001b(B\u001b[m                                          \u001b[2m\u2502  \u2502\u001b(B\u001b[m                             \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[23;93H  \u001b[2m\u2502\u001b(B\u001b[m                                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mChat with AI naturally\u001b(B\u001b[m     \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[24;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mProject\u001b[39m\u001b[1mPayFlow\u001b(B\u001b[m                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2m! for shell commands\u001b(B\u001b[m       \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[25;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mPlan   \u001b[36mv1\u001b[39m  \u001b[2m\"\u652f\u4ed8\u6d41\u7a0b v1\"\u001b(B\u001b[m                         \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mTab to autocomplete /cmds\u001b(B\u001b[m  \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[26;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mPhase  \u001b[39m\u001b[1m\u001b[2m[planning]\u001b(B\u001b[m \u001b[2m\u2192\u001b(B\u001b[m \u001b[2mactive\u001b(B\u001b[m \u001b[2m\u2192\u001b(B\u001b[m \u001b[2mcompleted\u001b(B\u001b[m       \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m  \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[27;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[90mTasks  \u001b[39m\u001b[2m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b(B\u001b[m  \u001b[2m0/2\u001b(B\u001b[m  \u001b[2m0\u25b6\u001b(B\u001b[m  \u001b[32m\u2713 no drift\u001b[39m       \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[1mRecent Activity\u001b(B\u001b[m            \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[28;93H  \u001b[2m\u2502\u001b(B\u001b[m                                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m                             \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[29;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[33m\u25b8\u001b[39m  \u001b[36mType: \"/tasks\" to pick a task and start\u001b[39m   \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mNo recent activity\u001b(B\u001b[m         \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[30;93H  \u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f  \u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b(B\u001b[m\u001b[K\u001b[31;93H\u001b[K\n  \u001b[2mChat with PlanSync AI.  /help for all commands\u001b(B\u001b[m\u001b[K\u001b[33;93H\u001b[K\u001b[2m\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[550.768734, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[35;93H[\u001b(B\u001b[mPayFlow \u001b[2m\u00b7\u001b(B\u001b[m \u001b[36mv1\u001b[39m \u001b[2m\u00b7\u001b(B\u001b[m \u001b[32m0\u25b6\u001b[39m\u001b[2m/2\u25ef]\u001b(B\u001b[m\u001b[34m\u276f\u001b[39m \u001b[2m/tasks\u001b(B\u001b[m\u001b[K\u001b[2m\u001b[36;93H\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b(B\u001b[m\u001b[37;93H\u001b[K\n  \u001b[1mTasks \u2014 PayFlow\u001b(B\u001b[m  \u001b[2m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b(B\u001b[m  \u001b[2m0/2 done\u001b(B\u001b[m\u001b[K\u001b[39;93H\u001b[K\n  \u001b[90m\u2500\u2500 Todo (2) \u2500\u2500\u001b[39m\u001b[K\u001b[41;93H    \u25cb Implement pay/card-form component  \u001b[33mP1\u001b[39m  \u001b[2m@bob\u001b(B\u001b[m\u001b[K\u001b[42;93H    \u25cb Review pay/card-form spec  \u001b[33mP1\u001b[39m  \u001b[2m@alice\u001b(B\u001b[m\u001b[K\u001b[43;93H\u001b[K\u001b[?12l\u001b[?25h\n"]
