[577.638209, "o", "\u001b[?25l\u001b[1d  \u001b[2mWhere Plans Meet Execution\u001b(B\u001b[m\u001b[K\u001b[2;93H\u001b[K\n                                        \u001b[K\u001b[4;93H  \u001b[1mSelect a project:\u001b(B\u001b[m\u001b[K\u001b[5;93H\u001b[K\n  \u001b[36m1\u001b[39m. \u001b[1mPayFlow\u001b(B\u001b[m\u001b[K\u001b[7;93H  \u001b[36m2\u001b[39m. \u001b[1mPlanSync Demo\u001b(B\u001b[m\u001b[K\u001b[8;93H  \u001b[36mn\u001b[39m. \u001b[2mCreate new project\u001b(B\u001b[m\u001b[K\u001b[9;93H  \u001b[36md\u001b[39m. \u001b[2mDelete a project\u001b(B\u001b[m\u001b[K\u001b[10;93H\u001b[K\n  Enter number [1-2], n, or d: 1\u001b[K\u001b[12;93H  \u001b[32m\u2713 Selected: PayFlow\u001b[39m\u001b[K\u001b[13;93H                                        \u001b[K\u001b[14;93H  \u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e  \u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b(B\u001b[m\u001b[K\u001b[15;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[36m\u001b[1mPlanSync Terminal\u001b(B\u001b[m                            \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[1mQuick Tips\u001b(B\u001b[m                 \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[16;93H  \u001b[2m\u2502\u001b(B\u001b[m  \u001b[2mbob\u001b(B\u001b[m                                          \u001b[2m\u2502  \u2502\u001b(B\u001b[m                             \u001b[2m\u2502\u001b(B\u001b[m\u001b[K\u001b[17;93H  \u001b[2m\u2502\u001b(B\u001b[m                                               \u001b[2m\u2502  \u2502\u001b(B\u001b[m  \u001b[2mChat with AI naturally\u001b(B\u001b[m     \u001b[2m\u2502\u001b(B\u001b[