[321.191579, "o", "\u001b[3G├─────────────────┼────────────────────────────────────────────┤\r\r\n\u001b[3G│\u001b[5GCard\u001b[10Gnumber\u001b[21G│\u001b[23GAuto-formats\u001b[36Gto\u001b[39G\u001b[38;5;153mXXXX\u001b[44GXXXX\u001b[49GXXXX\u001b[54GXXXX\u001b[66G\u001b[39m│\r\r\n\u001b[3G├─────────────────┼────────────────────────────────────────────┤\r\r\n\u001b[3G│\u001b[5GExpiry\u001b[12G(MM/YY)\u001b[21G│\u001b[23GAuto-inserts\u001b[36G\u001b[38;5;153m/\u001b[39m,\u001b[39Gvalidates\u001b[49Gmonth\u001b[55G+\u001b[57Gnot\u001b[61Gpast\u001b[66G│\r\r\n\u001b[3G├─────────────────┼────────────────────────────────────────────┤\r\r\n\u001b[3G│\u001b[5GCVV\u001b[21G│\u001b[23G\u001b[38;5;153mtype=\"password\"\u001b[39m,\u001b[40G3–4\u001b[44Gdigits\u001b[66G│\r\r\n\u001b[3G└─────────────────┴────────────────────────────────────────────┘\r\r\n\r\r\n\u001b[3GClient-side\u001b[15Gvalidation\u001b[26Gsurfaces\u001b[35Gerrors\u001b[42Gvia\u001b[46Gthe\u001b[50Gexisting\u001b[59G\u001b[38;5;153m<Alert\u001b[39m\r\r\n\u001b[3G\u001b[38;5;153mintent=\"danger\">\u001b[20G\u001b[39mcomponent.\u001b[31GSubmit\u001b[38Gstubs\u001b[44Ga\u001b[46G\u001b[38;5;153mfetch\u001b[52G\u001b[39mto\u001b[55G\u001b[38;5;153m/api/pay/charge\u001b[71G\u001b[39m(no\r\r\n\u001b[3Gbackend\u001b[11Grequired\u001b[20Gfor\u001b[24Gthis\u001b[29Gdeliverable).\r\r\n\r\r\n\u001b[3GNo\u001b[6Glayout\u001b[13Gfile\u001b[18Gneeded\u001b[25G—\u001b[27Gthe\u001b[31Gpage\u001b[36Gis\u001b[39Gstandalone.\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n❯ \u001b[7m \u001b[27m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;210m⏵⏵\u001b[6Gbypass\u001b[13Gpermissions\u001b[25Gon\u001b[38;5;246m (shift+tab\u001b[39Gto\u001b[42Gcycle)\u001b[49G·\u001b[51G←\u001b[53Gfor\u001b[57Gagents\u001b[39m\r\r\n\u001b[63G\u001b[38;5;246m●\u001b[65Ghigh\u001b[70G·\