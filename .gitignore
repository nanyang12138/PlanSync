# Runtime-generated server location (written by ps-admin start)
data/server_host

# Task execution sandboxes (git worktrees, auto-cleaned on exit)
.plansync-exec/

# Dependencies
node_modules/
.npm/
.local-runtime/
.local-runtime.stale-*/
.cache/

# Build outputs
dist/
.next/
out/

# Exception: the GitHub Action bundle MUST be checked in. `action.yml` runs
# `dist/index.js` directly on the consumer's runner — there is no install step,
# so the committed bundle is the deployable artifact. `scripts/build.sh`
# rebuilds it on every release; the dist-staleness guard in the same script
# fails CI if the committed bundle drifts from `index.ts`.
!packages/integrations/github-action/dist/
!packages/integrations/github-action/dist/**

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp / build cache
packages/api/tmp/
tmp/

*.nfs*

# Logs
*.log
pino-*.log

# Test coverage
coverage/

# Misc
*.tsbuildinfo

# AI tool local configs (user-specific, machine-specific paths — never commit)
.cursor/mcp.json
.cline_storage/
claude.local.md
*.local.md
# .claude/settings.json is committed (project MCP config, no hardcoded paths)
# .claude/settings.local.json is user-specific (gitignored)
.claude/settings.local.json
.claude/.nfs*

# Codex runtime data (user-specific, machine-specific)
.codex/

# Demo recordings (binary video/cast files)
demo-recordings/

# Local-only docs and build artifacts (not committed)
plansync-dist.zip
AI_Usage_Log.md
DOCUMENTATION.md
DOCUMENTATION.zh-CN.md
